+def _brute_force_knn_graph(
+    x: Tensor, k: int, batch: Optional[Tensor] = None
+) -> Tensor:
+    """Fallback kNN (O(n^2), CPU/pure-PyTorch) para quando `pyg_lib` nao
+    esta disponivel (sem wheel para esta combinacao de torch/Python -- ver
+    issue #18 do kappa-test). So para avaliacao local, nao para producao."""
+    n = x.size(0)
+    if batch is None:
+        batch = x.new_zeros(n, dtype=torch.long)
+    src_list, tgt_list = [], []
+    for b in torch.unique(batch):
+        idx = (batch == b).nonzero(as_tuple=True)[0]
+        xb = x[idx]
+        m = xb.size(0)
+        kk = min(k, m - 1)
+        if kk <= 0:
+            continue
+        dist = torch.cdist(xb, xb)
+        dist.fill_diagonal_(float("inf"))
+        knn_idx = dist.topk(kk, largest=False).indices  # [m, kk]
+        src_list.append(idx[knn_idx.reshape(-1)])
+        tgt_list.append(idx.unsqueeze(1).expand(-1, kk).reshape(-1))
+    return torch.stack([torch.cat(src_list), torch.cat(tgt_list)], dim=0)
+
+
+def knn_graph(x: Tensor, k: int, batch: Optional[Tensor] = None) -> Tensor:
+    """`knn_graph` com fallback automatico se `pyg_lib` nao estiver instalado."""
+    if pyg_typing.WITH_KNN:
+        return _pyg_knn_graph(x=x, k=k, batch=batch)
+    return _brute_force_knn_graph(x, k, batch)
+
+
